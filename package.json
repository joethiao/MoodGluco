{
  "name": "moodgluco",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "./scripts/start-all-tts.sh && expo start",
    "android": "./scripts/start-all-tts.sh && expo run:android",
    "ios": "./scripts/start-all-tts.sh && expo run:ios",
    "web": "expo start --web",
    "tts:xtts": "./scripts/start-tts.sh xtts start",
    "tts:edge": "./scripts/start-tts.sh edge start",
    "tts:kokoro": "./scripts/start-tts.sh kokoro start",
    "tts:piper": "./scripts/start-tts.sh piper start",
    "tts:stop:xtts": "./scripts/start-tts.sh xtts stop",
    "tts:stop:edge": "./scripts/start-tts.sh edge stop",
    "tts:stop:kokoro": "./scripts/start-tts.sh kokoro stop",
    "tts:stop:piper": "./scripts/start-tts.sh piper stop",
    "tts:status": "./scripts/start-tts.sh xtts status && ./scripts/start-tts.sh edge status && ./scripts/start-tts.sh kokoro status && ./scripts/start-tts.sh piper status",
    "vision:start": "./scripts/start-tts.sh vision start",
    "vision:stop": "./scripts/start-tts.sh vision stop",
    "vision:logs": "./scripts/start-tts.sh vision logs",
    "ollama:start:lan": "./scripts/start-ollama-lan.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "~2.1.2",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@shopify/react-native-skia": "2.2.12",
    "babel-preset-expo": "~54.0.10",
    "base64-js": "^1.5.1",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-av": "~14.0.0",
    "expo-camera": "~17.0.10",
    "expo-file-system": "^55.0.17",
    "expo-gl": "~16.0.10",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "^56.0.14",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~2.2.0",
    "react": "19.0.0",
    "react-native": "0.78.1",
    "react-native-feather": "^1.1.2",
    "react-native-reanimated": "^3.19.5",
    "react-native-safe-area-context": "~5.3.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "~15.15.4",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  },
  "private": true
